# Secrets / environment
.env
.env.*
!.env.example
Backend/.env
backend/.env

# Uploaded user documents (keep the placeholder)
Backend/uploads/*
backend/uploads/*
!Backend/uploads/.gitkeep
!backend/uploads/.gitkeep

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Node
node_modules/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
.qoder/

# Model caches / data
.hf_cache/
.huggingface/
huggingface/
pgdata/
*.sqlite

# Documents: ignore stray PDFs/DOCX except the synthetic samples
*.pdf
*.docx
*.doc
!Backend/sample_docs/
!Backend/sample_docs/*.pdf
!Backend/sample_docs/.gitkeep

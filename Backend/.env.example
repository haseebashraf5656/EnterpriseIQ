# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

# --- Database (provided by docker-compose for the db service) ---
DATABASE_URL=postgresql://eiq:eiq@db:5432/enterpriseiq
# Where uploaded files are stored inside the container (safe default: uploads)
UPLOAD_DIR=uploads

# --- Embeddings ---
# Sentence Transformers model used for chunk and query embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Cross-encoder reranker model
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Vector width; must match the embedding model (MiniLM = 384)
EMBEDDING_DIM=384

# --- Chunking and retrieval ---
CHUNK_MAX_TOKENS=200
CHUNK_MIN_TOKENS=120
CHUNK_OVERLAP_TOKENS=40
TOP_K=5
DENSE_CANDIDATES=20
BM25_CANDIDATES=20
FUSED_CANDIDATES=25
RRF_K=60
# Reranker score below which the answer is refused (needs real evidence)
RERANK_MIN_SCORE=-2.6

# --- LLM provider ---
# "gemini" or "ollama"
LLM_PROVIDER=gemini
# Get a key from Google AI Studio. Placeholder only; never commit a real key.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2

# --- Limits and CORS ---
# 10 MB default upload cap
MAX_UPLOAD_BYTES=10485760
MAX_QUESTION_CHARS=2000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8501
